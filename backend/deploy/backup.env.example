# /etc/wezcrypt-backup/backup.env (root:wezcrypt-backup, mode 640)
WZC_BACKUP_STORAGE_ROOT=/srv/wezcrypt/iphone-backups
WZC_BACKUP_STATE_DIR=/var/lib/wezcrypt-backup
WZC_BACKUP_TOKEN_PEPPER_FILE=/etc/wezcrypt-backup/token.pepper
WZC_BACKUP_MAX_CHUNK_SIZE=33554432
WZC_BACKUP_MAX_OBJECT_SIZE=68719476736
WZC_BACKUP_MIN_FREE_BYTES=2147483648
WZC_BACKUP_LOG_LEVEL=INFO
WZC_BACKUP_ENABLE_DOCS=false
