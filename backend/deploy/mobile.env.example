# /etc/wezcrypt-mobile/mobile.env  (chmod 600, owned by root)
# Secrets are referenced by FILE PATH, never inlined here.
WZC_MOBILE_DATA_DIR=/var/lib/wezcrypt-mobile
WZC_MOBILE_MASTER_KEY_FILE=/etc/wezcrypt-mobile/master.keys
WZC_MOBILE_INTERNAL_SECRET_FILE=/etc/wezcrypt-mobile/internal.secret
# Optional: separate pepper for token hashing (otherwise derived from the lowest key id).
# WZC_MOBILE_TOKEN_PEPPER_FILE=/etc/wezcrypt-mobile/token.pepper

# Telegram account ids allowed to pair devices (strongly recommended).
WZC_MOBILE_ALLOWED_TELEGRAM_IDS=
# Bot username without @, used for the one-tap t.me pairing link.
WZC_MOBILE_BOT_USERNAME=

# wzc2 = new objects in WZC2 segmented containers (range streaming, no plaintext on disk)
# legacy = hand every finished upload to the existing WZC1 code via WZC_MOBILE_LEGACY_STORE_HOOK
WZC_MOBILE_STORAGE_FORMAT=wzc2

# Hooks into the EXISTING studio code (module:function). Leave empty until wired.
# WZC_MOBILE_LEGACY_OPEN_HOOK=studio_bridge:open_wzc1
# WZC_MOBILE_LEGACY_PREVIEW_HOOK=studio_bridge:preview_wzc1
# WZC_MOBILE_LEGACY_LIST_HOOK=studio_bridge:list_wzc1
# WZC_MOBILE_LEGACY_STORE_HOOK=studio_bridge:store_wzc1
# PYTHONPATH=/opt/wezcrypt-studio

WZC_MOBILE_MAX_FILE_SIZE=21474836480
WZC_MOBILE_LOG_LEVEL=INFO
WZC_MOBILE_ENABLE_DOCS=false
