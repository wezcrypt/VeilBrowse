<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Intentionally empty so the IPA can be re-signed with any certificate and
	  provisioning profile (e.g. with KravaSigner). Keychain uses the default
	  access group, Secure Enclave keys need no entitlement, background modes are
	  declared in Info.plist, file protection is set per file in code.
	-->
</dict>
</plist>
